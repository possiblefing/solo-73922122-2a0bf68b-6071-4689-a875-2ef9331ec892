# Copy to .env or pass directly to docker compose.
POSTGRES_USER=fab
POSTGRES_PASSWORD=fabpass
POSTGRES_DB=fab
# Independent analysis receiver database.
ANALYSIS_PG_USER=analysis
ANALYSIS_PG_PASSWORD=analysispass
ANALYSIS_PG_DB=analysis
# Optional shared bearer token for source -> receiver delivery.  When empty,
# the receiver accepts unauthenticated deliveries (demo default).
# DELIVERY_TOKEN=change-me
# Leave SHUTDOWN_TOKEN unset in production to disable /internal/shutdown.
# SHUTDOWN_TOKEN=change-me
